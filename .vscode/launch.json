{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Avvia TTT Menu",
            "type": "cppdbg",
            "request": "launch",
            "program": "${fileDirname}/menu",
            "args": [],
            "stopAtEntry": false,
            "cwd": "${fileDirname}",
            "environment": [],
            "externalConsole": false,
            "MIMode": "gdb",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ],
            "preLaunchTask": "Build TTT (menu + impostazioni + gioco)",
            "miDebuggerPath": "/usr/bin/gdb"
        }
    ]
}