{
    "tasks": [
        {
            "type": "cppbuild",
            "label": "Build gioco (con impostazioni)",
            "command": "/usr/bin/gcc",
            "args": [
                "-fdiagnostics-color=always",
                "-g",
                "-DIMPOSTAZIONI_NO_MAIN",
                "${workspaceFolder}/src/gioco.c",
                "${workspaceFolder}/src/impostazioni.c",
                "-o",
                "${workspaceFolder}/TTT_gioco"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "detail": "Compila gioco.c + impostazioni.c (senza il main di impostazioni)."
        }
    ],
    "version": "2.0.0"
}