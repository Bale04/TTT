{
    "tasks": [
        {
            "type": "cppbuild",
            "label": "Build TTT (menu + impostazioni + gioco)",
            "command": "/usr/bin/gcc",
            "args": [
                "-fdiagnostics-color=always",
                "-g",
                "${fileDirname}/menu.c",
                "${fileDirname}/impostazioni.c",
                "${fileDirname}/gioco.c",
                "-o",
                "${fileDirname}/menu"
            ],
            "options": {
                "cwd": "${fileDirname}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "detail": "Compila menu.c + impostazioni.c + gioco.c in un unico eseguibile."
        },
        {
            "label": "Esegui TTT Menu",
            "type": "shell",
            "command": "${fileDirname}/menu",
            "options": {
                "cwd": "${fileDirname}"
            },
            "dependsOn": "Build TTT (menu + impostazioni + gioco)",
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "new",
                "focus": true
            },
            "detail": "Compila e avvia il menu nel terminale integrato."
        }
    ],
    "version": "2.0.0"
}